# Generate secrets locally with npm run setup. Never paste keys into chat.
DATA_DIR=/var/lib/yachad
MASTER_KEY_FILE=/etc/yachad/master.key
CONNECTOR=mock
# Switching this to baileys also requires explicit local acknowledgement:
ALLOW_REAL_WHATSAPP=no
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://yachad.home.arpa
COOKIE_SECURE=true
# Optional direct Node TLS, if not using Caddy:
# TLS_CERT_FILE=/etc/yachad/tls/cert.pem
# TLS_KEY_FILE=/etc/yachad/tls/key.pem
MAX_MEDIA_MB=16
MAX_STORAGE_MB=2048
CHILD_IDLE_MINUTES=15
SESSION_HOURS=12

# Encrypted hourly aggregates only; no conversation content or per-child activity log.
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_RETENTION_DAYS=7
DIAGNOSTICS_FLUSH_SECONDS=300
