<Window x:Class="Yahad.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="יחד | התקנה" Width="980" Height="730" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F7F8F4" FontFamily="Segoe UI Variable, Segoe UI" Foreground="#263E3A" Language="he-IL" FlowDirection="RightToLeft">
 <Grid Background="#F7F8F4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
  <Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
    <Viewbox Width="35" Height="35" Margin="0,0,0,0"><Canvas Width="32" Height="32"><Path Data="M27,15 C27,23 20,28 12,26 L4,29 L6,21 C1,11 7,3 16,3 C23,3 27,8 27,15Z" Stroke="#157C69" StrokeThickness="2"/><Path Data="M16,21 L10,15 C6,10 12,7 16,12 C20,7 26,10 22,15Z" Fill="#157C69"/></Canvas></Viewbox>
    <TextBlock Text="יחד" FontSize="29" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel>
    <Border DockPanel.Dock="Left" Background="#EAEDE6" CornerRadius="18" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="0.5.3 · Windows" FontSize="12" FlowDirection="LeftToRight" Foreground="#53645F"/></Border>
   </DockPanel>
   <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,28,0,14"><StackPanel>
    <TextBlock x:Name="Eyebrow" Text="מתחילים בבית, ביחד" FontSize="13" Foreground="#157C69" FontWeight="SemiBold"/>
    <TextBlock x:Name="Heading" Text="עוד רגע,&#10;יחד אצלכם בבית." FontSize="35" FontWeight="SemiBold" LineHeight="45" Margin="0,10,0,14"/>
    <TextBlock x:Name="Description" Text="המתקין כולל את כל הרכיבים הדרושים. נתקין את השירות, נפעיל את יחד ונפתח את ההגדרה המשפחתית בדפדפן." FontSize="16" LineHeight="26" Foreground="#5C716B"/>
    <Border x:Name="InstallSteps" Background="White" BorderBrush="#DFE7E0" BorderThickness="1" CornerRadius="18" Padding="21" Margin="0,22,0,0"><StackPanel>
     <TextBlock Text="כמה צעדים פשוטים" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <TextBlock x:Name="Step1" Text="01   מכינים את הרכיבים של יחד" FontSize="14" Margin="0,0,0,13"/>
     <TextBlock x:Name="Step2" Text="02   מתקינים ומפעילים את שירות Windows" FontSize="14" Margin="0,0,0,13"/>
     <TextBlock x:Name="Step3" Text="03   ממשיכים להגדרה המשפחתית בדפדפן" FontSize="14"/>
    </StackPanel></Border>
    <Button x:Name="RemovalEntry" Visibility="Collapsed" Content="אפשרויות הסרה להתקנה הקיימת" Click="RemovalOptions_Click" Background="Transparent" Foreground="#157C69" HorizontalAlignment="Right" Margin="0,8,0,0" FontSize="13"/>
    <StackPanel x:Name="LanPanel" Margin="0,18,0,0">
     <TextBlock Text="איפה משתמשים ביחד?" FontSize="18" FontWeight="SemiBold"/>
     <RadioButton x:Name="KeepLan" GroupName="LanMode" IsChecked="True" Checked="LanChanged" Content="ללא שינוי בגישה לרשת" Margin="0,12,0,0"/>
     <TextBlock Text="בהתקנה חדשה: שימוש במחשב הזה בלבד. בהתקנה קיימת: הגדרות הגישה נשמרות." FontSize="12" Foreground="#5C716B" Margin="22,5,0,8"/>
     <RadioButton x:Name="HomeLan" GroupName="LanMode" Checked="LanChanged" Content="גם בטלפונים ובטאבלטים ברשת הביתית" Margin="0,5,0,8"/>
     <StackPanel x:Name="LanSelection" Visibility="Collapsed" Margin="20,0,0,12">
      <TextBlock Text="בחרו במפורש את החיבור הביתי. כתובת פרטית יכולה להיות גם של VPN; אין בחירה אוטומטית." FontSize="13" TextWrapping="Wrap"/>
      <ComboBox x:Name="LanAddress" DisplayMemberPath="Label" SelectionChanged="LanAddressChanged" MinHeight="36" Margin="0,9,0,9" AutomationProperties.Name="החיבור לרשת הביתית"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <CheckBox x:Name="LanHttpHelp" IsChecked="True" Checked="LanChanged" Unchecked="LanChanged" VerticalAlignment="Top" AutomationProperties.LabeledBy="{Binding ElementName=LanHelpLabel}"/>
       <TextBlock x:Name="LanHelpLabel" Grid.Column="1" Text="דף עזרה מקומי והורדת תעודה ציבורית (HTTP, פורט 80)" TextWrapping="Wrap" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock x:Name="LanProgram" FontSize="11" FlowDirection="LeftToRight" TextWrapping="Wrap" Margin="0,10,0,6"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <CheckBox x:Name="LanConsent" Checked="LanChanged" Unchecked="LanChanged" VerticalAlignment="Top" AutomationProperties.LabeledBy="{Binding ElementName=LanConsentLabel}"/>
       <TextBlock x:Name="LanConsentLabel" Grid.Column="1" Text="אני מאשר/ת לאפשר לתוכנית Caddy המוצגת למעלה חיבורים נכנסים ב־TCP 443, וב־80 אם נבחר דף עזרה, רק בפרופיל Private ומהתת־רשת המקומית. לא תיפתח גישה בנתב או לאינטרנט." TextWrapping="Wrap" FontSize="13" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock Text="HTTPS מקומי ללא חשבון או דומיין. יש לאשר את התעודה בכל מכשיר, לאחר השוואה מול מסך המחשב הזה. המחשב צריך להישאר פועל; שינוי כתובת הרשת דורש תיקון כאן." FontSize="12" TextWrapping="Wrap" Foreground="#5C716B" Margin="0,9,0,0"/>
     </StackPanel>
     <RadioButton x:Name="DisableLan" GroupName="LanMode" Checked="LanChanged" Content="כיבוי הגישה הביתית והסרת כללי חומת האש של יחד" Margin="0,4,0,0"/>
    </StackPanel>
    <Border x:Name="LanResultPanel" Visibility="Collapsed" Background="White" BorderBrush="#DFE7E0" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,16,0,0">
     <StackPanel><TextBlock Text="הצטרפות ממכשיר נוסף בבית" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="LanResultText" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBox x:Name="LanRootFingerprint" IsReadOnly="True" FlowDirection="LeftToRight" TextWrapping="Wrap" FontSize="13" Margin="0,12,0,0" AutomationProperties.Name="טביעת SHA-256 של תעודת הבית, להשוואה ממכשיר נוסף"/>
      <Button x:Name="SaveLanCertificate" Content="שמירת התעודה הציבורית" Click="SaveLanCertificate_Click" Margin="0,10,0,0"/>
      <TextBlock Text="השוו את טביעת התעודה במכשיר החדש לטביעה שמופיעה כאן, לפני מתן אמון. הדף בטלפון אינו יודע לקרוא את הגדרות האמון. בדיקת HTTPS היא בדיקת חיבור בלבד; כשל אינו הוכחה שחסרה תעודה. אין לדלג על אזהרת דפדפן." TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
    <StackPanel x:Name="UninstallChoices" Visibility="Collapsed" Margin="0,22,0,0">
     <RadioButton x:Name="KeepOption" GroupName="RemovalMode" IsChecked="True" Checked="RemovalChanged" Style="{StaticResource RemovalCard}" TabIndex="0" AutomationProperties.Name="הסרת התוכנה ושמירת הנתונים. ברירת המחדל המומלצת.">
      <StackPanel><TextBlock Text="הסרת התוכנה ושמירת הנתונים" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="ברירת המחדל" Foreground="#157C69" FontSize="12" Margin="0,5,0,7"/><TextBlock Text="השירות וקובצי התוכנה יוסרו. שיחות, משתמשים, מפתחות, נתוני חיבור WhatsApp וגיבויים יישארו להתקנה חוזרת." FontSize="13" Foreground="#5C716B" LineHeight="21"/></StackPanel>
     </RadioButton>
     <RadioButton x:Name="DeleteOption" GroupName="RemovalMode" Checked="RemovalChanged" Tag="danger" Style="{StaticResource RemovalCard}" Margin="0,12,0,0" TabIndex="1" AutomationProperties.Name="הסרה ומחיקה מלאה. מחיקת כל הנתונים המקומיים של יחד.">
      <StackPanel><TextBlock Text="הסרה ומחיקה מלאה" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="השירות, קובצי התוכנה וכל תיקיית הנתונים של יחד יוסרו מהמחשב הזה, כולל שיחות, משתמשים, מפתחות וגיבויים שבתיקייה." FontSize="13" Foreground="#5C716B" LineHeight="21" Margin="0,7,0,0"/></StackPanel>
     </RadioButton>
     <Border x:Name="DeleteConfirmation" Visibility="Collapsed" Background="#FFF1ED" BorderBrush="#E6B6AD" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,15,0,0">
      <StackPanel><TextBlock Text="המחיקה סופית" FontWeight="SemiBold" FontSize="16" Foreground="#96392D"/>
       <TextBlock Text="לא ניתן לבטל את הפעולה. גם גיבויים שנשמרו בתוך תיקיית יחד יימחקו. גיבויים שייצאתם למיקום אחר וקובץ ההתקנה שהורדתם לא יימחקו." FontSize="13" LineHeight="22" Margin="0,8,0,12"/>
       <TextBlock x:Name="ConfirmationLabel" Text="לאישור, הקלידו את המילה מחיקה" FontSize="14" FontWeight="SemiBold"/>
       <TextBox x:Name="ConfirmationInput" TextChanged="ConfirmationChanged" FontSize="17" Padding="12,9" Margin="0,8,0,0" MaxLength="16" TabIndex="2" AutomationProperties.LabeledBy="{Binding ElementName=ConfirmationLabel}"/>
      </StackPanel>
     </Border>
     <TextBlock Text="התיקייה המושפעת: C:\ProgramData\Yahad.FirstInstall" FontSize="12" Foreground="#5C716B" Margin="2,12,2,0"/>
    </StackPanel>
    <Border x:Name="Notice" Background="#EAF1EA" CornerRadius="13" Padding="16" Margin="0,16,0,0"><TextBlock x:Name="NoticeText" Text="Windows יבקש אישור כדי להתקין את השירות. הוא יפעל ברקע גם לאחר סגירת המתקין, ויופעל עם המחשב." FontSize="13" Foreground="#46665B" LineHeight="22"/></Border>
    <ProgressBar x:Name="ProgressBar" Visibility="Collapsed" Height="7" Maximum="100" Foreground="#157C69" Background="#DFE7E0" BorderThickness="0" Margin="0,18,0,0" AutomationProperties.Name="התקדמות ההתקנה"/>
    <TextBlock x:Name="Status" FontSize="13" Foreground="#5C716B" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel></ScrollViewer>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="Primary" TabIndex="3" ToolTipService.ShowOnDisabled="True" Content="מתקינים את יחד" Click="Start_Click" HorizontalAlignment="Stretch"/>
    <Button x:Name="Secondary" TabIndex="4" Grid.Column="1" Content="סגירה" Click="Close_Click" Background="Transparent" Foreground="#5C716B" Margin="8,0,0,0"/>
   </Grid>
  </Grid>
  <Border Grid.Column="1" Background="#173F36"><Grid Margin="28,36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="SideHeading" Text="קרובים בבית.&#10;מחוברים ביחד." FontSize="27" FontWeight="SemiBold" Foreground="#F0F3E8" LineHeight="39"/>
   <Grid x:Name="SideIllustration" Grid.Row="1" IsHitTestVisible="False"><Ellipse Width="220" Height="220" Fill="#1F5044" VerticalAlignment="Center"/>
    <StackPanel VerticalAlignment="Center"><Border Background="#F3F5ED" CornerRadius="18,18,5,18" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="המשפחה שלנו" Foreground="#157C69" FontSize="12" FontWeight="Bold"/><TextBlock Text="מקום קטן לשיחות של הבית" FontSize="17" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="#CBE1CC" CornerRadius="18,18,18,5" Padding="18" HorizontalAlignment="Left"><TextBlock Text="כל הבית ביחד" FontSize="20"/></Border></StackPanel>
   </Grid>
   <StackPanel x:Name="UninstallSideDetails" Visibility="Collapsed" Grid.Row="2"><TextBlock Text="הבחירה שלכם, במחשב הזה." Foreground="#F0F3E8" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="שמירת הנתונים מאפשרת להתקין מחדש ולהמשיך מאותו מקום. מחיקה מלאה מסירה גם את נתוני החיבור המקומיים ל־WhatsApp ואת הגיבויים שבתיקיית יחד." Foreground="#BED0C3" FontSize="14" LineHeight="24" Margin="0,14,0,0"/><TextBlock Text="הפעולה לא משנה מכשירים אחרים או הגדרות רשת." Foreground="#BED0C3" FontSize="13" LineHeight="22" Margin="0,20,0,0"/></StackPanel>
   <StackPanel x:Name="InstallSideDetails" Grid.Row="2"><TextBlock Text="ההגדרות שלכם, בדרך שלכם." FontSize="17" Foreground="#F0F3E8" FontWeight="SemiBold"/>
    <TextBlock Text="משתמשים, ילדים וחיבור WhatsApp מוגדרים מתוך יחד לאחר ההתקנה." FontSize="13" Foreground="#BED0C3" LineHeight="23" Margin="0,10,0,0"/>
    <TextBlock Text="השלב הראשון פותח את יחד במחשב הזה. חיבור ממכשירים נוספים מצריך הגדרת גישה מאובטחת." FontSize="12" Foreground="#BED0C3" LineHeight="21" Margin="0,18,0,0"/>
   </StackPanel>
  </Grid></Border>
 </Grid>
</Window>
