<Window x:Class="Yahad.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="יחד | התקנה" Width="980" Height="730" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F7F8F4" FontFamily="Segoe UI Variable, Segoe UI" Foreground="#263E3A" Language="he-IL" FlowDirection="RightToLeft">
 <Grid Background="#F7F8F4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
  <Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
    <Viewbox Width="35" Height="35" Margin="0,0,0,0"><Canvas Width="32" Height="32"><Path Data="M27,15 C27,23 20,28 12,26 L4,29 L6,21 C1,11 7,3 16,3 C23,3 27,8 27,15Z" Stroke="#157C69" StrokeThickness="2"/><Path Data="M16,21 L10,15 C6,10 12,7 16,12 C20,7 26,10 22,15Z" Fill="#157C69"/></Canvas></Viewbox>
    <TextBlock Text="יחד" FontSize="29" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel>
    <Border DockPanel.Dock="Left" Background="#EAEDE6" CornerRadius="18" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="0.5.3 · Windows" FontSize="12" FlowDirection="LeftToRight" Foreground="#53645F"/></Border>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,28,0,14"><StackPanel>
    <TextBlock x:Name="Eyebrow" Text="מתחילים בבית, ביחד" FontSize="13" Foreground="#157C69" FontWeight="SemiBold"/>
    <TextBlock x:Name="Heading" Text="עוד רגע,&#10;יחד אצלכם בבית." FontSize="35" FontWeight="SemiBold" LineHeight="45" Margin="0,10,0,14"/>
    <TextBlock x:Name="Description" Text="המתקין כולל את כל הרכיבים הדרושים. נתקין את השירות, נפעיל את יחד ונפתח את ההגדרה המשפחתית בדפדפן." FontSize="16" LineHeight="26" Foreground="#5C716B"/>
    <Border Background="White" BorderBrush="#DFE7E0" BorderThickness="1" CornerRadius="18" Padding="21" Margin="0,22,0,0"><StackPanel>
     <TextBlock Text="כמה צעדים פשוטים" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <TextBlock x:Name="Step1" Text="01   מכינים את הרכיבים של יחד" FontSize="14" Margin="0,0,0,13"/>
     <TextBlock x:Name="Step2" Text="02   מתקינים ומפעילים את שירות Windows" FontSize="14" Margin="0,0,0,13"/>
     <TextBlock x:Name="Step3" Text="03   ממשיכים להגדרה המשפחתית בדפדפן" FontSize="14"/>
    </StackPanel></Border>
    <Border x:Name="Notice" Background="#EAF1EA" CornerRadius="13" Padding="16" Margin="0,16,0,0"><TextBlock x:Name="NoticeText" Text="Windows יבקש אישור כדי להתקין את השירות. הוא יפעל ברקע גם לאחר סגירת המתקין, ויופעל עם המחשב." FontSize="13" Foreground="#46665B" LineHeight="22"/></Border>
    <ProgressBar x:Name="ProgressBar" Visibility="Collapsed" Height="7" Maximum="100" Foreground="#157C69" Background="#DFE7E0" BorderThickness="0" Margin="0,18,0,0" AutomationProperties.Name="התקדמות ההתקנה"/>
    <TextBlock x:Name="Status" FontSize="13" Foreground="#5C716B" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel></ScrollViewer>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="Primary" Content="מתקינים את יחד" Click="Start_Click" HorizontalAlignment="Stretch"/>
    <Button x:Name="Secondary" Grid.Column="1" Content="סגירה" Click="Close_Click" Background="Transparent" Foreground="#5C716B" Margin="8,0,0,0"/>
   </Grid>
  </Grid>
  <Border Grid.Column="1" Background="#173F36"><Grid Margin="28,36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="קרובים בבית.&#10;מחוברים ביחד." FontSize="27" FontWeight="SemiBold" Foreground="#F0F3E8" LineHeight="39"/>
   <Grid Grid.Row="1" IsHitTestVisible="False"><Ellipse Width="220" Height="220" Fill="#1F5044" VerticalAlignment="Center"/>
    <StackPanel VerticalAlignment="Center"><Border Background="#F3F5ED" CornerRadius="18,18,5,18" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="המשפחה שלנו" Foreground="#157C69" FontSize="12" FontWeight="Bold"/><TextBlock Text="מקום קטן לשיחות של הבית" FontSize="17" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="#CBE1CC" CornerRadius="18,18,18,5" Padding="18" HorizontalAlignment="Left"><TextBlock Text="כל הבית ביחד" FontSize="20"/></Border></StackPanel>
   </Grid>
   <StackPanel Grid.Row="2"><TextBlock Text="ההגדרות שלכם, בדרך שלכם." FontSize="17" Foreground="#F0F3E8" FontWeight="SemiBold"/>
    <TextBlock Text="משתמשים, ילדים וחיבור WhatsApp מוגדרים מתוך יחד לאחר ההתקנה." FontSize="13" Foreground="#BED0C3" LineHeight="23" Margin="0,10,0,0"/>
    <TextBlock Text="השלב הראשון פותח את יחד במחשב הזה. חיבור ממכשירים נוספים מצריך הגדרת גישה מאובטחת." FontSize="12" Foreground="#BED0C3" LineHeight="21" Margin="0,18,0,0"/>
   </StackPanel>
  </Grid></Border>
 </Grid>
</Window>
