<Window x:Class="Yahad.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="יחד · הכנת הבית" Width="1040" Height="760"
 MinWidth="940" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F7F8F4"
 FontFamily="Segoe UI" Foreground="#263E3A" Language="he-IL" FlowDirection="RightToLeft">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
  <Grid Margin="44,30,44,28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel LastChildFill="False">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
     <Viewbox Width="34" Height="34" Margin="0,0,10,0"><Canvas Width="32" Height="32">
      <Path Data="M 27,15 C 27,23 20,28 12,26 L 4,29 L 6,21 C 1,11 7,3 16,3 C 23,3 27,8 27,15 Z" Stroke="#157C69" StrokeThickness="2"/>
      <Path Data="M 16,21 L 10,15 C 6,10 12,7 16,12 C 20,7 26,10 22,15 Z" Fill="#157C69"/>
     </Canvas></Viewbox>
     <TextBlock Text="יחד" FontSize="30" FontWeight="Bold"/>
    </StackPanel>
    <Border DockPanel.Dock="Left" Background="#EAEDE6" CornerRadius="20" Padding="12,6" VerticalAlignment="Center">
     <TextBlock Text="בדיקת פיתוח מבודדת" Foreground="#53645F" FontSize="11"/>
    </Border>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,34,0,14">
    <StackPanel>
     <TextBlock x:Name="Eyebrow" Text="מתחילים בבית, בנחת" Foreground="#157C69" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
     <TextBlock x:Name="Heading" Text="עוד רגע,&#10;מקום בטוח לדבר." FontSize="37" FontWeight="SemiBold" LineHeight="47"/>
     <TextBlock x:Name="Description" Text="נכין ליחד מקום במחשב. אחר כך ממשיכים בדפדפן, יוצרים הורה ומצרפים את הילדים." FontSize="16" Foreground="#5C716B" LineHeight="26" Margin="0,15,0,23"/>
     <Border Background="White" CornerRadius="18" Padding="21" BorderBrush="#DFE7E0" BorderThickness="1">
      <StackPanel>
       <TextBlock Text="מה קורה בדרך?" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="01" Foreground="#157C69" FontSize="13" FlowDirection="LeftToRight"/>
        <TextBlock x:Name="Step1" Grid.Column="1" Text="בודקים את חבילת ההתקנה" FontSize="14" Margin="0,0,0,14"/>
        <TextBlock Grid.Row="1" Text="02" Foreground="#157C69" FontSize="13" FlowDirection="LeftToRight"/>
        <TextBlock x:Name="Step2" Grid.Row="1" Grid.Column="1" Text="מכינים מקום פרטי לקבצים" FontSize="14" Margin="0,0,0,14"/>
        <TextBlock Grid.Row="2" Text="03" Foreground="#157C69" FontSize="13" FlowDirection="LeftToRight"/>
        <TextBlock x:Name="Step3" Grid.Row="2" Grid.Column="1" Text="מוודאים שאפשר להמשיך בבטחה" FontSize="14"/>
       </Grid>
      </StackPanel>
     </Border>
     <Border x:Name="Notice" Background="#EAF1EA" CornerRadius="13" Padding="16" Margin="0,16,0,0">
      <TextBlock x:Name="NoticeText" Text="כאן בודקים קבצים לדוגמה בלבד. לא יותקנו שירותים ולא ישתנו חומת האש או אישורי האבטחה במחשב." FontSize="13" LineHeight="21" Foreground="#46665B"/>
     </Border>
     <ProgressBar x:Name="ProgressBar" Visibility="Collapsed" Height="6" Maximum="100" Foreground="#157C69" Background="#DFE7E0" BorderThickness="0" Margin="0,18,0,0" AutomationProperties.Name="התקדמות הבדיקה"/>
     <TextBlock x:Name="Status" FontSize="12" Foreground="#5C716B" Margin="0,9,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="2">
    <Button Content="תכנון כניסה ממכשיר נוסף" Click="LanPlan_Click" Background="Transparent" Foreground="#157C69" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="Primary" Content="התחלת בדיקה  ←" Click="Start_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="התחלת בדיקה מבודדת"/>
     <Button x:Name="Secondary" Grid.Column="1" Content="סגירה" Click="Close_Click" Background="Transparent" Foreground="#5C716B" Margin="8,0,0,0"/>
    </Grid>
    <TextBlock Text="יחד במחשב שלכם. ההחלטות בידיים שלכם." Foreground="#71847C" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0"/>
   </StackPanel>
  </Grid>
  <Border Grid.Column="1" Background="#173F36">
   <Grid Margin="30,38,30,32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="השיחות שלהם.&#10;השקט שלכם." FontSize="28" FontWeight="SemiBold" Foreground="#F0F3E8" LineHeight="40"/>
    <Grid Grid.Row="1" Margin="0,28,0,25" FlowDirection="LeftToRight" IsHitTestVisible="False">
     <Ellipse Width="260" Height="260" Fill="#1F5044" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Ellipse Width="208" Height="208" Stroke="#3B6659" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <StackPanel VerticalAlignment="Center" Margin="0,12,0,0">
      <Border Background="#F3F5ED" CornerRadius="19,19,5,19" Padding="18" Width="246" HorizontalAlignment="Left" Margin="0,0,0,14" RenderTransformOrigin="0.5,0.5">
       <Border.RenderTransform><RotateTransform Angle="-4"/></Border.RenderTransform>
       <StackPanel FlowDirection="RightToLeft"><TextBlock Text="המשפחה שלנו" Foreground="#157C69" FontSize="12" FontWeight="Bold" Margin="0,0,0,7"/><TextBlock Text="איזה כיף שכולנו כאן 💚" FontSize="17"/><TextBlock Text="עכשיו" FontSize="10" Foreground="#71847C" Margin="0,9,0,0"/></StackPanel>
      </Border>
      <Border Background="#CBE1CC" CornerRadius="19,19,19,5" Padding="18" Width="209" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
       <Border.RenderTransform><RotateTransform Angle="3"/></Border.RenderTransform>
       <StackPanel FlowDirection="RightToLeft"><TextBlock Text="גם אני פה!" FontSize="20"/><TextBlock Text="מקום קטן. קשר גדול." FontSize="11" Foreground="#46665B" Margin="0,7,0,0"/></StackPanel>
      </Border>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2">
     <Border BorderBrush="#3B6659" BorderThickness="0,1,0,0" Margin="0,0,0,22"/>
     <TextBlock Text="קרובים, בדרך שלכם." FontSize="19" FontWeight="SemiBold" Foreground="#F0F3E8" Margin="0,0,0,9"/>
     <TextBlock Text="ההורה בוחר. הילדים מדברים.&#10;הבית נשאר המרכז." FontSize="14" LineHeight="24" Foreground="#BED0C3"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
