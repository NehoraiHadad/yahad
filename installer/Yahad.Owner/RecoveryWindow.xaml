<Window x:Class="Yahad.Owner.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="התאוששות מעדכון | יחד" Width="580" Height="580" MinWidth="460" MinHeight="480" FlowDirection="RightToLeft" FontFamily="Segoe UI Variable, Segoe UI" FontSize="16" Background="#F5F7EF" Foreground="#173D34" WindowStartupLocation="CenterScreen">
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="יחד" Foreground="#157C69" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="התאוששות מעדכון" FontSize="28" FontWeight="SemiBold" Margin="0,20,0,12"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="אפשר לבדוק ולתקן עדכון שהופסק גם כשהיישום המשפחתי אינו נפתח. רק ההורה שהוגדר בהתקנה יכול לאשר את הפעולה." TextWrapping="Wrap" LineHeight="25"/>
   <TextBlock Text="הכנת האפשרות עשויה להשהות יישום שכבר פועל, ורק לאחר שנבדק שהוא פנוי. הוא יישאר במצב התאוששות עד להשלמת הפעולה." TextWrapping="Wrap" LineHeight="25" Margin="0,12,0,0"/>
   <Border Background="White" CornerRadius="16" Padding="22" Margin="0,20,0,18"><StackPanel>
    <TextBlock Text="עדכון לבדיקה" FontWeight="SemiBold"/><ComboBox x:Name="Operations" DisplayMemberPath="Label" Margin="0,12,0,16" AutomationProperties.Name="בחירת עדכון שהופסק"/>
    <TextBlock Text="תחילה תיבדק האפשרות הבטוחה. אם נדרש שחזור, יוצג אישור נפרד: הגיבוי ישוחזר לעותק חדש, והנתונים הקיימים יישמרו. שינויים מאוחרים יותר לא יועברו אוטומטית לעותק המשוחזר." TextWrapping="Wrap" LineHeight="25"/>
   </StackPanel></Border>
   <TextBlock x:Name="Status" Text="קוראים את מצב ההתאוששות…" TextWrapping="Wrap" LineHeight="25" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
   <Button x:Name="Prepare" Content="הצגת אפשרות התאוששות" Click="Prepare_Click" Padding="20,12" Background="#157C69" Foreground="White" BorderThickness="0" IsEnabled="False"/>
   <Button x:Name="Refresh" Content="בדיקת מצב" Click="Refresh_Click" Padding="18,12" Margin="12,0,0,0" Background="Transparent" BorderThickness="0"/>
  </StackPanel>
 </Grid>
</Window>
