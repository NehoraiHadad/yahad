{
  "enabled": false,
  "repository": "NehoraiHadad/yahad",
  "releaseTrust": "github-https",
  "mode": "notify",
  "allowUiModeControl": false,
  "installVersionPin": null,
  "operator": { "familyId": "REPLACE_WITH_FAMILY_UUID", "userId": "REPLACE_WITH_PARENT_UUID" },
  "checkHours": 6,
  "publicKeyFile": null,
  "tokenFile": null,
  "backupPassphraseFile": "/etc/yachad/update-backup-passphrase",
  "backupDirectory": "/var/backups/yachad-updates",
  "dataDirectory": "/var/lib/yachad",
  "masterKeyFile": "/etc/yachad/master.key",
  "releasesDirectory": "/opt/yachad/releases",
  "currentLink": "/opt/yachad/current",
  "stateDirectory": "/var/lib/yachad-updates",
  "buildDirectory": "/var/lib/yachad-update-build",
  "builderUser": "yachad-update",
  "appUser": "yachad",
  "service": "yachad.service",
  "node": "/usr/local/bin/node",
  "npm": "/usr/local/bin/npm",
  "healthUrl": "http://127.0.0.1:3000/health/ready",
  "healthTimeoutSeconds": 90,
  "minimumFreeMiB": 512
}
